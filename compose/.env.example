# Copy to .env and fill in. Generate with:
#   openssl rand -hex 12   → DB_PASSWORD
#   openssl rand -hex 8    → HMAC_KEY
#   openssl rand -hex 8    → COMPANION_KEY  (must be exactly 16 alphanumeric chars)
#
# INVIDIOUS_DOMAIN = your tailscale hostname, e.g. mylaptop.tailabc123.ts.net
# (find yours: tailscale status --json | grep MagicDNSSuffix)

DB_PASSWORD=
DB_USER=
HMAC_KEY=
COMPANION_KEY=
INVIDIOUS_DOMAIN=
